# Copy to .env.local and fill in from Supabase > Project Settings > API.
# These are exposed to the browser by design, so protect data with Row Level Security.
# Never put the service_role key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Shown in the account menu until real sign-in is added.
NEXT_PUBLIC_USER_EMAIL=
